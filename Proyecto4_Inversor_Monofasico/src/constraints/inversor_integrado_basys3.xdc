# Plataforma completa: JA para PWM, JB1 para medir la ISR y JXADC para VAUX6.
set_property -dict {PACKAGE_PIN W5 IOSTANDARD LVCMOS33} [get_ports clk_i]
set_property -dict {PACKAGE_PIN U18 IOSTANDARD LVCMOS33} [get_ports reset_i]
set_property -dict {PACKAGE_PIN T18 IOSTANDARD LVCMOS33} [get_ports {botones[0]}]
set_property -dict {PACKAGE_PIN U17 IOSTANDARD LVCMOS33} [get_ports {botones[1]}]
set_property -dict {PACKAGE_PIN W19 IOSTANDARD LVCMOS33} [get_ports {botones[2]}]
set_property -dict {PACKAGE_PIN V17 IOSTANDARD LVCMOS33} [get_ports {amplitud[0]}]
set_property -dict {PACKAGE_PIN V16 IOSTANDARD LVCMOS33} [get_ports {amplitud[1]}]
set_property -dict {PACKAGE_PIN R2 IOSTANDARD LVCMOS33 PULLDOWN true} [get_ports permiso_pwm]
set_property -dict {PACKAGE_PIN B18 IOSTANDARD LVCMOS33} [get_ports uart_rx]
set_property -dict {PACKAGE_PIN A18 IOSTANDARD LVCMOS33} [get_ports uart_tx]
set_property -dict {PACKAGE_PIN U16 IOSTANDARD LVCMOS33} [get_ports {led[0]}]
set_property -dict {PACKAGE_PIN E19 IOSTANDARD LVCMOS33} [get_ports {led[1]}]
set_property -dict {PACKAGE_PIN U19 IOSTANDARD LVCMOS33} [get_ports {led[2]}]
set_property -dict {PACKAGE_PIN V19 IOSTANDARD LVCMOS33} [get_ports {led[3]}]
set_property -dict {PACKAGE_PIN A14 IOSTANDARD LVCMOS33} [get_ports isr_debug]
set_property -dict {PACKAGE_PIN J3 IOSTANDARD LVCMOS33} [get_ports vauxp6]
set_property -dict {PACKAGE_PIN K3 IOSTANDARD LVCMOS33} [get_ports vauxn6]
# Clocking Wizard genera la restriccion del reloj de entrada a 100 MHz.
set_false_path -from [get_ports {reset_i botones[*] amplitud[*] permiso_pwm uart_rx}]
set_false_path -to [get_ports {uart_tx led[*] isr_debug pwm_ah pwm_al pwm_bh pwm_bl pwm_period_start_o}]
set_property CONFIG_VOLTAGE 3.3 [current_design]
set_property CFGBVS VCCO [current_design]
