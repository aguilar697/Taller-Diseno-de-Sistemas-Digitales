<mxfile host="drawio">
  <diagram id="n4lazo" name="Inicialización y lazo principal">
    <mxGraphModel dx="800" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="ini" value="Reset" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p1" value="Inicialización: CONTROL = 0, variables en cero,&lt;br&gt;ADC, PWM (con lectura de comprobación) y Timer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="100" width="340" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="d1" value="¿Configuración&lt;br&gt;correcta?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="190" y="190" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="f1" value="estado = FALLA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="205" width="180" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="estado = DETENIDO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="300" width="340" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p3" value="Arrancar el Timer y habilitar interrupciones" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="380" width="340" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p4" value="Leer botones e interruptores&lt;br&gt;(antirrebote con el contador de iteraciones)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="470" width="340" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p5" value="Procesar eventos: solicitud de habilitar o apagar,&lt;br&gt;reconocer falla, amplitud pendiente, exportar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="560" width="340" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p6" value="Actualizar LED&lt;br&gt;(operación, falla, exportando, latido)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="650" width="340" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p7" value="Un paso de la exportación:&lt;br&gt;escribir bytes mientras la FIFO TX tenga espacio" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="740" width="340" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="a0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ini" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p1" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" value="Sí" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="d1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d1" target="f1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="f1" target="p3">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="590" y="405"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p6" target="p7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a10" value="repetir" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p7" target="p4">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="70" y="770"/><mxPoint x="70" y="500"/></Array></mxGeometry>
        </mxCell>

        <mxCell id="nota" value="El lazo no espera en ningún punto. La ISR lo interrumpe en cualquier paso." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="660" width="200" height="60" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
