<mxfile host="drawio">
  <diagram id="n3est" name="Estados de la aplicación">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Entrada -->
        <mxCell id="RST" value="Reset" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="30" y="200" width="120" height="60" as="geometry"/>
        </mxCell>

        <!-- Estados -->
        <mxCell id="INI" value="&lt;b&gt;INICIO&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;configura Timer, PWM,&lt;br&gt;ADC, UART y GPIO&lt;br&gt;PWM deshabilitado&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="220" y="180" width="170" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="DET" value="&lt;b&gt;DETENIDO&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;enable = 0&lt;br&gt;estados del PR en cero&lt;br&gt;mide y registra&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="520" y="180" width="170" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="OPE" value="&lt;b&gt;OPERACIÓN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;running = 1&lt;br&gt;PR en lazo cerrado&lt;br&gt;mide y registra&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="860" y="180" width="170" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="FAL" value="&lt;b&gt;FALLA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;enable = 0 inmediato&lt;br&gt;LED de falla&lt;br&gt;mide y registra&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="520" y="450" width="170" height="100" as="geometry"/>
        </mxCell>

        <!-- Transiciones -->
        <mxCell id="t0" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="RST" target="INI">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t1" value="configuración&lt;br&gt;completa" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="INI" target="DET">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="botón habilitar&lt;br&gt;(PWM arranca, running = 1)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="DET" target="OPE">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-22" as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t3" value="botón habilitar&lt;br&gt;(enable = 0)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="OPE" target="DET">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="22" as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t4" value="|i_med| &amp;gt; I_max&lt;br&gt;ADC fuera de rango&lt;br&gt;muestras perdidas o repetidas&lt;br&gt;ISR excede el período&lt;br&gt;running = 0 al habilitar" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;align=left;strokeColor=#b85450;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="OPE" target="FAL">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="945" y="500"/>
            </Array>
            <mxPoint x="-60" y="-80" as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t5" value="comprobación de&lt;br&gt;registros incorrecta" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#b85450;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="INI" target="FAL">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="305" y="500"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="t6" value="botón reconocer" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.3;exitY=0;entryX=0.3;entryY=1;" edge="1" parent="1" source="FAL" target="DET">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-55" as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="t7" value="condición de&lt;br&gt;falla" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#b85450;exitX=0.7;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="DET" target="FAL">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="50" as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- Nota -->
        <mxCell id="NOTA" value="La exportación UART es una actividad del lazo principal y puede ocurrir en DETENIDO, OPERACIÓN o FALLA; no cambia el estado del control." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="220" y="600" width="470" height="50" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
