<mxfile host="drawio">
  <diagram id="n3cn" name="Software como caja negra">
    <mxGraphModel dx="1150" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="SW" value="&lt;b style=&quot;font-size:17px&quot;&gt;Software de control PR y comunicación&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;(C en MicroBlaze V, memoria local de 32 KB)&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Regula la corriente de la carga con un PR discreto,&lt;br&gt;una iteración por interrupción del Timer.&lt;br&gt;&lt;br&gt;Guarda un histórico de muestras y lo exporta&lt;br&gt;por UART cuando se presiona el botón.&lt;/span&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="390" y="130" width="420" height="380" as="geometry"/>
        </mxCell>

        <!-- Arriba -->
        <mxCell id="P" value="Parámetros de configuración" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- Izquierda: hardware de control -->
        <mxCell id="T" value="Interrupción del Timer" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="A" value="Registros del ADC" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="245" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="W" value="Registros del PWM" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="G" value="GPIO: salida de medición" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="435" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- Derecha: usuario y PC -->
        <mxCell id="K" value="GPIO: botones e interruptores" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1010" y="170" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="E" value="GPIO: LED" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1010" y="290" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="U" value="UART TX" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1010" y="410" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="APP" value="&lt;b&gt;Aplicación de PC&lt;/b&gt;&lt;br&gt;CSV, gráficas, error y desfase" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1010" y="540" width="190" height="60" as="geometry"/>
        </mxCell>

        <!-- Conexiones -->
        <mxCell id="eP" value="coeficientes, Vdc, I_max, escalas" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="P" target="SW"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eT" value="inicia una iteración" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.1316;" edge="1" parent="1" source="T" target="SW"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eA" value="código, n, estado" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.3816;" edge="1" parent="1" source="A" target="SW"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eW" value="REFERENCE, CONTROL&lt;br&gt;(lee running)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=0;exitY=0.6316;entryX=1;entryY=0.5;" edge="1" parent="1" source="SW" target="W"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eG" value="pulso durante la ISR" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=0;exitY=0.8816;entryX=1;entryY=0.5;" edge="1" parent="1" source="SW" target="G"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eK" value="exportar, habilitar,&lt;br&gt;reconocer, amplitud" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=0;exitY=0.5;entryX=1;entryY=0.1842;" edge="1" parent="1" source="K" target="SW"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eE" value="operación, falla,&lt;br&gt;exportando, latido" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="SW" target="E"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eU" value="trama con CRC" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.8158;entryX=0;entryY=0.5;" edge="1" parent="1" source="SW" target="U"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eAPP" value="puerto serie" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="U" target="APP"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
